{
  "name": "minikraken.com",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "agents:update": "bunx skills update -p",
    "build": "bun --bun vp build",
    "check": "bun fmt:check && bun lnt",
    "check:watch": "bun --bun svelte-kit sync && bunx sv check --tsconfig ./tsconfig.json --watch",
    "dev": "bun --bun vp dev --host 127.0.0.1",
    "email:build": "email dev --packageManager bun --dir src/lib/mailing/templates",
    "email:dev": "email dev --dir src/lib/mailing/templates",
    "email:export": "email export --dir src/lib/mailing/templates ",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lnt": "eslint .",
    "prepare": "bun --bun svelte-kit sync",
    "preview": "portless minikraken bun --bun /build/index.js",
    "release": "bunx release-it",
    "release:ci": "bunx release-it --ci",
    "test": "bun run test:unit -- --run",
    "test:unit": "vp test"
  },
  "dependencies": {
    "@formisch/svelte": "^1.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "elysia": "^1.4.30",
    "import-in-the-middle": "^3.5.0",
    "mdsvex": "^0.12.8",
    "motion": "^13.2.0",
    "motion-plus-dom": "^2.12.0",
    "nope-id": "^1.4.1",
    "posthog-js": "^1.429.5",
    "resend": "^6.27.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.1",
    "@release-it/conventional-changelog": "^12.0.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/enhanced-img": "^0.11.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/language-server": "^0.16.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "gray-matter": "^4.0.3",
    "lefthook": "^2.1.12",
    "openapi-types": "^12.1.3",
    "playwright": "^1.63.0",
    "release-it": "^21.0.2",
    "sharp": "^0.35.4",
    "super-sitemap": "^2.0.6",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-language-server": "^0.18.4",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typebox": "^1.3.30",
    "typescript": "^6.0.2",
    "typescript-svelte-plugin": "^0.3.52",
    "unplugin-macros": "^0.23.2",
    "vite": "^8.3.0",
    "vite-plugin-image-optimizer": "^2.0.3"
  },
  "browserslist": [
    "defaults and fully supports es6-module"
  ],
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "trustedDependencies": [
    "@sveltejs/kit",
    "@tailwindcss/oxide",
    "core-js",
    "esbuild",
    "lefthook",
    "sharp",
    "svelte-preprocess"
  ]
}
